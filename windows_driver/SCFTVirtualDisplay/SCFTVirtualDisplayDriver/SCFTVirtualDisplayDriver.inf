[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Class=Display
ClassVer=2.0
Provider=%ManufacturerName%
CatalogFile=SCFTVirtualDisplayDriver.cat
DriverVer=07/28/2026,1.0.0.0

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$.10.0...22000

[Standard.NT$ARCH$.10.0...22000]
%DeviceName%=SCFTVirtualDisplay_Install,Root\SCFTVirtualDisplayDriver
%DeviceName%=SCFTVirtualDisplay_Install,SCFTVirtualDisplayDriver

[SourceDisksFiles]
SCFTVirtualDisplayDriver.dll=1

[SourceDisksNames]
1=%DiskName%

[SCFTVirtualDisplay_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy

[SCFTVirtualDisplay_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=SCFTVirtualDisplay_HardwareSettings

[SCFTVirtualDisplay_HardwareSettings]
HKR,,"UpperFilters",%REG_MULTI_SZ%,"IndirectKmd"
HKR,"WUDF","DeviceGroupId",%REG_SZ%,"SCFTVirtualDisplayDriverGroup"

[SCFTVirtualDisplay_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[SCFTVirtualDisplay_Install.NT.Wdf]
UmdfService=SCFTVirtualDisplayDriver,SCFTVirtualDisplayDriver_Install
UmdfServiceOrder=SCFTVirtualDisplayDriver
UmdfKernelModeClientPolicy=AllowKernelModeClients

[SCFTVirtualDisplayDriver_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\SCFTVirtualDisplayDriver.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
UMDriverCopy=12,UMDF

[UMDriverCopy]
SCFTVirtualDisplayDriver.dll

[Strings]
ManufacturerName="SCFT"
DiskName="SCFT Virtual Display Installation Disk"
DeviceName="SCFT Virtual Display"
REG_MULTI_SZ=0x00010000
REG_SZ=0x00000000